<Window x:Class="PxUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="代理设置" Width="520" Height="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource TitleBrush}">
            <Grid>
                <TextBlock Text="代理设置" Foreground="White" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource TitleIcon}" Content="&#xE8BB;" Click="Close_Click"
                        HorizontalAlignment="Right" Margin="0,0,8,0"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="16,14,16,0">
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="上游代理" Style="{StaticResource H1}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="类型" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TypeBox" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <ComboBoxItem Content="socks5"/>
                            <ComboBoxItem Content="http"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="地址" Style="{StaticResource Dim}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="HostBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"/>
                        <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="2"/>

                        <TextBlock Grid.Row="2" Text="用户名" Style="{StaticResource Dim}"
                                   VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Margin="0,8,8,0"/>

                        <TextBlock Grid.Row="3" Text="密码" Style="{StaticResource Dim}"
                                   VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox x:Name="PassBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                 Margin="0,8,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="拦截引擎" Style="{StaticResource H1}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#9AA1AC"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="未启动" Style="{StaticResource Dim}"
                                       Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Button x:Name="ToggleButton" Style="{StaticResource Primary}" Content="启动"
                            Click="Toggle_Click" Margin="0,12,0,0" Width="96"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Padding="16,12" Background="White" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Button Style="{StaticResource Ghost}" Content="取消" Click="Close_Click"
                        HorizontalAlignment="Right" Margin="0,0,100,0" Width="80"/>
                <Button Style="{StaticResource Primary}" Content="保存" Click="Save_Click"
                        HorizontalAlignment="Right" Width="80"/>
            </Grid>
        </Border>
    </Grid>
</Window>
