<Window x:Class="PxUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PxUi" Width="880" Height="660" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource TitleBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="&#xE968;" FontFamily="{StaticResource Icons}" FontSize="17"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="PxUi" Foreground="White" FontSize="15.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="9,0,0,1"/>
                    <Border Background="#33FFFFFF" CornerRadius="4" Padding="6,1" Margin="8,2,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="v0.2" Foreground="White" FontSize="10.5"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleIcon}" Content="&#xE921;" Click="Min_Click" ToolTip="最小化"/>
                    <Button Style="{StaticResource TitleIcon}" Content="&#xE922;" Click="Max_Click" ToolTip="最大化"/>
                    <Button Style="{StaticResource TitleIcon}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,16,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="环境列表" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="CountText" Text="0 个配置" Style="{StaticResource Dim}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Ghost}" Content="代理节点" Click="Proxy_Click"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Primary}" Content="新建环境" Click="New_Click"
                                Width="104"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#FAFBFC" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="名称" Style="{StaticResource Dim}"/>
                            <TextBlock Grid.Column="1" Text="浏览器" Style="{StaticResource Dim}"/>
                            <TextBlock Grid.Column="2" Text="时区 / 语言" Style="{StaticResource Dim}"/>
                            <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource Dim}"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="ProfileList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource RowItem}"
                             MouseDoubleClick="ProfileList_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="46">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5"/>
                                        <TextBlock Text="{Binding Remark}" Style="{StaticResource Dim}"
                                                   FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding BrowserKind}"
                                               Style="{StaticResource Dim}" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Timezone}" FontSize="12"/>
                                        <TextBlock Text="{Binding Language}" Style="{StaticResource Dim}"
                                                   FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Dim}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Ghost}" Content="打开"
                                                Click="Open_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource Ghost}" Content="编辑"
                                                Click="Edit_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource Ghost}" Content="删除"
                                                Click="Delete_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="还没有配置，点右上角新建"
                               Style="{StaticResource Dim}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="日志" Style="{StaticResource H1}"/>
                    <Button Style="{StaticResource Ghost}" Content="清空" HorizontalAlignment="Right"
                            Click="ClearLog_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
