<Window x:Class="PxUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PxUi" Width="760" Height="700" MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource TitleBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="&#xE968;" FontFamily="{StaticResource Icons}" FontSize="17"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="PxUi" Foreground="White" FontSize="15.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="9,0,0,1"/>
                    <Border Background="#33FFFFFF" CornerRadius="4" Padding="6,1" Margin="8,2,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="v0.1" Foreground="White" FontSize="10.5"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleIcon}" Content="&#xE921;" Click="Min_Click" ToolTip="最小化"/>
                    <Button Style="{StaticResource TitleIcon}" Content="&#xE922;" Click="Max_Click" ToolTip="最大化"/>
                    <Button Style="{StaticResource TitleIcon}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16,18,18">
            <StackPanel>

                <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="拦截状态" Style="{StaticResource H1}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#9AA1AC"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="未启动" Style="{StaticResource Dim}"
                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ToggleButton" Style="{StaticResource Primary}"
                                    Content="启动" Click="Toggle_Click" Width="96"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="目标应用" Style="{StaticResource H1}"/>
                        <TextBlock Text="改动立即生效" Style="{StaticResource Dim}" Margin="0,2,0,10"/>
                        <CheckBox x:Name="ChromeCheck" Content="Google Chrome" Margin="0,0,0,8"
                                  Checked="Target_Changed" Unchecked="Target_Changed"/>
                        <CheckBox x:Name="EdgeCheck" Content="Microsoft Edge" Margin="0,0,0,2"
                                  Checked="Target_Changed" Unchecked="Target_Changed"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="上游代理" Style="{StaticResource H1}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="类型" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TypeBox" Grid.Column="1" Margin="0,0,8,8">
                                <ComboBoxItem Content="socks5"/>
                                <ComboBoxItem Content="http"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="地址" Style="{StaticResource Dim}"
                                       VerticalAlignment="Center" Margin="8,0,8,8"/>
                            <TextBox x:Name="HostBox" Grid.Column="3" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Text="端口" Style="{StaticResource Dim}"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"/>

                            <TextBlock Grid.Row="2" Text="认证" Style="{StaticResource Dim}"
                                       VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Margin="0,8,8,0"/>
                            <TextBox x:Name="PassBox" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                     Margin="8,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="高级" Style="{StaticResource H1}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="端口段起始" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <TextBox x:Name="BasePortBox" Grid.Column="1" Margin="0,0,8,8"/>
                            <TextBlock Grid.Column="2" Text="端口数量" Style="{StaticResource Dim}"
                                       VerticalAlignment="Center" Margin="8,0,8,8"/>
                            <TextBox x:Name="PortCountBox" Grid.Column="3" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Text="空闲回收(秒)" Style="{StaticResource Dim}"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="IdleBox" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="日志" Style="{StaticResource H1}"/>
                            <Button Style="{StaticResource Ghost}" Content="清空" HorizontalAlignment="Right"
                                    Click="ClearLog_Click"/>
                        </Grid>
                        <TextBox x:Name="LogBox" Margin="0,10,0,0" Height="130" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11.5"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
